# Required: Your Google Gemini API key
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini model to use (default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Optional: Max upload size in bytes (default: 2MB)
MAX_UPLOAD_SIZE=2097152

# Optional: Session TTL in seconds (default: 1800 = 30 minutes)
SESSION_TTL=1800
